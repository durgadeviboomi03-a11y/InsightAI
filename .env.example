# ============================================================
# .env.example
#
# Copy this file to .env and fill in real values.
# .env is gitignored and never committed — this file is the
# committed template showing what's required.
#
#   Windows PowerShell:  copy .env.example .env
#   macOS/Linux:          cp .env.example .env
# ============================================================

# ---------- General ----------
APP_NAME=InsightAI
APP_ENV=development
DEBUG=True

# ---------- Database ----------
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://insightai_user:insightai_pass@localhost:3306/insightai

# ---------- Authentication / JWT ----------
# IMPORTANT: Generate a strong, random secret for real use — never use
# this example value in production. You can generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-generate-a-real-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- File Upload ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

# ---------- Reports ----------
REPORTS_DIR=reports
CHARTS_DIR=charts

# ---------- ML Models ----------
MODELS_DIR=models

# ---------- Generative AI ----------
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- MySQL (used by docker-compose.yml) ----------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=insightai
MYSQL_USER=insightai_user
MYSQL_PASSWORD=insightai_pass